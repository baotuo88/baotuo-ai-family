# Native/local deployment template. For Docker use: cp .env.docker.example .env
# Docker also accepts this file but overrides local data/workspace paths.
GATEWAY_IMAGE=ghcr.io/baotuo88/baotuo-ai-family:latest
GATEWAY_HTTP_PORT=18080
GATEWAY_AUTO_CONFIGURE=1
PORT=18080
HOST=127.0.0.1
# 至少 32 字符的随机管理令牌；留空将禁用管理 HTTP 接口。
GATEWAY_ADMIN_TOKEN=
TIMEZONE=Asia/Shanghai
DATA_DIR=./data
# 文件工作区保留期限与总容量上限；清理命令默认只预览，追加 --apply 才会删除。
DATA_RETENTION_DAYS=30
DATA_MAX_WORKSPACE_BYTES=10737418240

WECHAT_API_BASE_URL=https://ilinkai.weixin.qq.com
WECHAT_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
WECHAT_CHANNEL_VERSION=weixin-household-codex-gateway-0.1.0
WECHAT_ROUTE_TAG=
# 全局任务并发上限（1–32），同一联系人仍按顺序执行。
WECHAT_MAX_CONCURRENT_TASKS=4
WECHAT_TYPING_REFRESH_MS=7000
WECHAT_THINKING_NOTICE_MS=30000
WECHAT_TURN_MESSAGE_LIMIT=10
WECHAT_ADMIN_PROGRESS_ENABLED=true
WECHAT_FAMILY_PROGRESS_ENABLED=false
WECHAT_FAMILY_API_STREAMING_ENABLED=false

SESSION_ADMIN_AUTO_ROTATE_ENABLED=false
SESSION_FAMILY_AUTO_ROTATE_ENABLED=true
SESSION_FAMILY_HOT_IDLE_MINUTES=90

# 留空时使用项目 node_modules 中锁定的隔离版本。
CODEX_ADMIN_COMMAND=
CODEX_ADMIN_ARGS=exec --skip-git-repo-check
CODEX_ADMIN_BACKEND=acp
CODEX_ADMIN_ACP_COMMAND=
CODEX_ADMIN_ACP_ARGS=
CODEX_ADMIN_ACP_AUTH_MODE=auto
CODEX_ADMIN_HOME=
CODEX_ADMIN_MODE=full-auto
CODEX_ADMIN_WORKSPACE=./runtime/codex-admin
CODEX_ADMIN_ENV_MODE=inherit
CODEX_ADMIN_ENV_PASSTHROUGH=

CODEX_FAMILY_COMMAND=
CODEX_FAMILY_ARGS=exec --skip-git-repo-check
CODEX_FAMILY_BACKEND=acp
CODEX_FAMILY_ACP_COMMAND=
CODEX_FAMILY_ACP_ARGS=
CODEX_FAMILY_ACP_AUTH_MODE=auto
# family ACP 运行时会强制使用 WORKSPACE-codex-home，避免复用 admin/login 凭据目录。
CODEX_FAMILY_HOME=
CODEX_FAMILY_MODE=suggest
CODEX_FAMILY_WORKSPACE=./runtime/codex-family
CODEX_FAMILY_ENV_MODE=minimal
CODEX_FAMILY_ENV_PASSTHROUGH=

CODEX_TIMEOUT_MS=180000

# 机器人专用认证目录默认 DATA_DIR/codex-home，不沿用个人 CODEX_HOME。
# login = 沿用 `codex login`；api_key = 写入 CODEX_CLI_API_KEY，适合 sub2api / API key 模式。
CODEX_CLI_AUTH_MODE=api_key
CODEX_CLI_HOME=
CODEX_CLI_PROVIDER=OpenAI
CODEX_CLI_PROVIDER_NAME=OpenAI
CODEX_CLI_BASE_URL=
CODEX_CLI_API_KEY=
# 如果启用 CODEX_*_BACKEND=acp，本项目会自动把 CODEX_CLI_API_KEY
# 作为 OPENAI_API_KEY/CODEX_API_KEY 传给 codex-acp，通常不用重复写 key。
# CODEX_*_ACP_AUTH_MODE=auto 时：有 key 就显式认证；没 key 就让 codex-acp 自己使用官方登录态。
CODEX_CLI_WIRE_API=responses
CODEX_CLI_MODEL=gpt-5.6-sol
CODEX_CLI_APPROVAL_POLICY=on-request
CODEX_CLI_SANDBOX_MODE=workspace-write
# 可选：本机 CLI 与 admin/family ACP 共用的 Codex 模型指令文件，建议使用绝对路径。
CODEX_CLI_MODEL_INSTRUCTIONS_FILE=
CODEX_CLI_REVIEW_MODEL=gpt-5.5
CODEX_CLI_REASONING_EFFORT=high
CODEX_CLI_CONTEXT_WINDOW=1000000
CODEX_CLI_AUTO_COMPACT_TOKEN_LIMIT=900000

# 可选：如果要用 OpenAI-compatible API 中转站，可把 CODEX_*_COMMAND 指到 dist/apps/server/codex-api-wrapper.js。
CODEX_API_BASE_URL=
CODEX_API_KEY=
CODEX_API_MODEL=gpt-5.6-sol
CODEX_API_TIMEOUT_MS=180000

# 可选：配置多个供应商 profile，然后在微信里用 /provider 切换。
# 名字只能用字母、数字、点、横线、下划线；变量后缀会转成大写下划线。
# 例：CODEX_PROVIDER_NAMES=vendorx
# CODEX_PROVIDER_VENDORX_DISPLAY_NAME=Vendor X
# CODEX_PROVIDER_VENDORX_API_BASE_URL=https://vendor.example/v1
# CODEX_PROVIDER_VENDORX_API_KEY=sk-...
# CODEX_PROVIDER_VENDORX_MODEL=gpt-5.6-sol
# 新 API_BASE_URL 不会继承默认供应商的 Key；需要鉴权时必须配置独立 API_KEY。
# CODEX_PROVIDER_VENDORX_CODEX_HOME=/var/lib/baotuo-ai-family/codex-vendorx
# 可选：继续追加 Codex 配置覆盖；API_BASE_URL/provider 配置会自动生成。
# CODEX_PROVIDER_VENDORX_ACP_ARGS=-c model_reasoning_effort=\"high\"
CODEX_PROVIDER_NAMES=
# 可选：/provider ccswitch 读取 cc-switch 的 Codex 供应商列表，默认 ~/.cc-switch/cc-switch.db。
CC_SWITCH_DB_PATH=

FAMILY_STRIP_REASONING=true
FAMILY_STRIP_COMMANDS=true
FAMILY_STRIP_PATHS=true
ALLOW_FILE_SEND=true

# 微信内 /file 命令只允许发送这些目录里的文件。Linux/macOS 用 : 分隔，Windows 用 ; 分隔。
FILE_SEND_ALLOWED_DIRS=./data/outbox:./data/inbox:./data/office
FILE_SEND_MAX_BYTES=52428800
