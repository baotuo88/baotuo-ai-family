# Copy to .env, edit the values, then run: docker compose up -d
# Compose >= 2.30 reads container values literally (format: raw).
# Do not surround values with quotes. Do not commit actual credentials.
# Image must have been published successfully by GitHub Actions.
GATEWAY_IMAGE=ghcr.io/baotuo88/baotuo-ai-family:latest
GATEWAY_HTTP_PORT=18080
# 1 = bootstrap Codex config when a Key exists and no dashboard settings are saved.
# Use 0 only when maintaining /data/codex-home yourself (e.g. existing login).
GATEWAY_AUTO_CONFIGURE=1
# Optional: reuse an existing volume; never share it with a second running service.
# GATEWAY_DATA_VOLUME=baotuo-ai-family_gateway-data
TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai
# Generate with: openssl rand -hex 32
GATEWAY_ADMIN_TOKEN=

# Optional: leave model credentials blank and configure them at /admin after startup.
# Login username: admin; management token: GATEWAY_ADMIN_TOKEN above.
# Dashboard settings take precedence for configured roles and survive restarts.
# Bot-only API credentials. Set the model to one your provider actually supports.
CODEX_CLI_AUTH_MODE=api_key
CODEX_CLI_BASE_URL=https://api.openai.com/v1
CODEX_CLI_API_KEY=
CODEX_CLI_MODEL=
CODEX_CLI_REASONING_EFFORT=high
CODEX_CLI_PROVIDER=OpenAI
CODEX_CLI_PROVIDER_NAME=OpenAI
CODEX_CLI_WIRE_API=responses
CODEX_CLI_APPROVAL_POLICY=on-request
CODEX_CLI_SANDBOX_MODE=workspace-write
CODEX_ADMIN_BACKEND=acp
CODEX_FAMILY_BACKEND=acp
CODEX_ADMIN_ACP_AUTH_MODE=auto
CODEX_FAMILY_ACP_AUTH_MODE=auto
CODEX_ADMIN_MODE=full-auto
CODEX_FAMILY_MODE=suggest
CODEX_ADMIN_ENV_MODE=minimal
CODEX_FAMILY_ENV_MODE=minimal
CODEX_TIMEOUT_MS=180000
WECHAT_MAX_CONCURRENT_TASKS=4
WECHAT_ADMIN_PROGRESS_ENABLED=true
WECHAT_FAMILY_PROGRESS_ENABLED=false
WECHAT_FAMILY_API_STREAMING_ENABLED=false
FILE_SEND_MAX_BYTES=52428800
DATA_RETENTION_DAYS=30
DATA_MAX_WORKSPACE_BYTES=10737418240

# Optional independent family chat endpoint. Omit unused overrides.
# CODEX_FAMILY_API_BASE_URL=https://provider.example/v1
# CODEX_FAMILY_API_KEY=
# CODEX_FAMILY_API_MODEL=
